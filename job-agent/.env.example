ANTHROPIC_API_KEY=
# Apollo's people-search API needs a paid plan; without a key (or without
# paid access) contacts.py just marks contact lookup for manual review.
APOLLO_API_KEY=

# All optional -- only used by `jobagent daily` to email the shortlist.
# Leave blank to skip email; the shortlist still gets saved to
# data/shortlists/<date>.txt either way.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=
