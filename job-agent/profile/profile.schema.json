{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Candidate profile",
  "description": "Source of truth for every claim the agent is allowed to make in a resume or cover letter. Every fact needs an id so the validator can trace generated bullets back to it.",
  "type": "object",
  "required": ["name", "roles", "projects", "skills", "education"],
  "properties": {
    "name": { "type": "string" },
    "contact": {
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "location": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } }
      }
    },
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "company", "start", "bullets", "tags"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "company": { "type": "string" },
          "location": { "type": "string" },
          "start": { "type": "string", "description": "YYYY-MM" },
          "end": { "type": "string", "description": "YYYY-MM or 'present'" },
          "bullets": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text", "tags"],
              "properties": {
                "id": { "type": "string" },
                "text": { "type": "string", "description": "Plain-text fact, no LLM embellishment" },
                "tags": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "tags"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "url": { "type": "string" },
          "tags": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "category": { "type": "string" }
        }
      }
    },
    "education": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "institution", "credential"],
        "properties": {
          "id": { "type": "string" },
          "institution": { "type": "string" },
          "credential": { "type": "string" },
          "graduation_date": { "type": "string", "description": "YYYY-MM, used by eligibility filters" },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
